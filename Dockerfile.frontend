# Frontend - React (Create React App) servido con nginx
# Node 16 trae OpenSSL 1.1, evita el error de react-scripts 3.4.1 con OpenSSL 3.

FROM node:16-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY public ./public
COPY src ./src
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/build /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
