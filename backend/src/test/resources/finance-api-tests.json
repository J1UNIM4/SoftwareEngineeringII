{
  "info": {
    "name": "Finance API Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Crear Persona",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": {"raw": "http://localhost:8080/persons", "host": ["localhost"], "port": "8080", "path": ["persons"]},
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"test@gmail.com\", \"name\": \"Test User\", \"birthdate\": \"1990-01-01\", \"birthplace\": \"Porto\"}"
        }
      },
      "event": [{
        "listen": "test",
        "script": {"exec": ["pm.test('Status 201', function(){ pm.response.to.have.status(201); });"]}
      }]
    },
    {
      "name": "Crear Cuenta",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": {"raw": "http://localhost:8080/persons/test@gmail.com/accounts", "host": ["localhost"], "port": "8080", "path": ["persons", "test@gmail.com", "accounts"]},
        "body": {
          "mode": "raw",
          "raw": "{\"description\": \"My Wallet\", \"denomination\": \"Wallet\"}"
        }
      },
      "event": [{
        "listen": "test",
        "script": {"exec": ["pm.test('Status 201', function(){ pm.response.to.have.status(201); });"]}
      }]
    },
    {
      "name": "Crear Transaccion",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": {"raw": "http://localhost:8080/persons/test@gmail.com/ledgers/records", "host": ["localhost"], "port": "8080", "path": ["persons", "test@gmail.com", "ledgers", "records"]},
        "body": {
          "mode": "raw",
          "raw": "{\"denominationCategory\": \"Food\", \"type\": \"debit\", \"description\": \"Lunch\", \"amount\": 50.0, \"denominationAccountDeb\": \"Wallet\", \"denominationAccountCred\": \"Bank\", \"date\": \"2024-01-01\"}"
        }
      },
      "event": [{
        "listen": "test",
        "script": {"exec": ["pm.test('Status 201', function(){ pm.response.to.have.status(201); });"]}
      }]
    },
    {
      "name": "Validacion - Monto Negativo",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": {"raw": "http://localhost:8080/persons/test@gmail.com/ledgers/records", "host": ["localhost"], "port": "8080", "path": ["persons", "test@gmail.com", "ledgers", "records"]},
        "body": {
          "mode": "raw",
          "raw": "{\"denominationCategory\": \"Food\", \"type\": \"debit\", \"description\": \"Lunch\", \"amount\": -50.0, \"denominationAccountDeb\": \"Wallet\", \"denominationAccountCred\": \"Bank\", \"date\": \"2024-01-01\"}"
        }
      },
      "event": [{
        "listen": "test",
        "script": {"exec": ["pm.test('Status 400', function(){ pm.response.to.have.status(400); });"]}
      }]
    }
  ]
}