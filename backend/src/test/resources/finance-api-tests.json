  },
  "item": [
    {
      "name": "Crear Persona",
      "request": {
        "auth": {"type": "basic", "basic": [{"key": "username", "value": "admin", "type": "string"}, {"key": "password", "value": "admin123", "type": "string"}]},
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": {"raw": "http://localhost:8080/persons", "host": ["localhost"], "port": "8080", "path": ["persons"]},
        "body": {"mode": "raw", "raw": "{\"email\": \"testqa@gmail.com\", \"name\": \"Test QA\", \"birthdate\": \"1990-01-01\", \"birthplace\": \"Porto\"}"}
      },
      "event": [{"listen": "test", "script": {"exec": ["pm.test('Status 201', function(){ pm.response.to.have.status(201); });"]}}]
    },
    {
